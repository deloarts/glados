# Module boundaries, checked by `poetry run lint-imports` (docs/reference/module-boundaries.md section 4,
# ADR 0012). Each module under src/modules/ keeps its layers inside, imports only the modules
# it declares (tests/unit/test_context_boundaries.py DEPENDS_ON, which a test keeps in step
# with the contracts below), and reaches another module only through its public API: its
# api.py and its named interfaces, the domain events, value objects and errors, the DTOs and
# the ports it owns. The ignore lists hold the imports that break a rule today, each group
# with its reason. They only shrink: an entry that matches no import fails the run.

[importlinter]
root_package = src
include_external_packages = True

[importlinter:contract:layers]
name = Inside every module: adapters, then application, then ports, then domain
type = layers
containers =
    src.modules.platform
    src.modules.catalogue
    src.modules.workspace
    src.modules.external_data
    src.modules.fulfillment
    src.modules.quality
    src.modules.operations
layers =
    adapters
    application
    ports
    domain

[importlinter:contract:domain]
name = Domain code imports no outer layer and no framework
type = forbidden
source_modules =
    src.modules.*.domain
    src.shared_kernel
forbidden_modules =
    src.modules.*.application
    src.modules.*.adapters
    src.modules.*.infrastructure
    src.modules.*.ports
    src.read
    src.bootstrap
    fastapi
    starlette
    sqlalchemy
    pydantic
    pydantic_settings
    boto3
    botocore
    azure
    redis
    ldap3

[importlinter:contract:ports]
name = Ports import no application code and no adapters of any module
type = forbidden
source_modules =
    src.modules.*.ports
    src.read.ports
forbidden_modules =
    src.modules.*.application
    src.modules.*.adapters
    src.read.application
    src.read.adapters
    src.bootstrap

[importlinter:contract:application]
name = Application code imports no adapters of any module
type = forbidden
source_modules =
    src.modules.*.application
    src.read.application
forbidden_modules =
    src.modules.*.adapters
    src.read.adapters
    src.bootstrap

[importlinter:contract:infrastructure]
name = Infrastructure has no application or adapter dependencies
type = forbidden
source_modules =
    src.modules.*.infrastructure
forbidden_modules =
    src.modules.*.application
    src.modules.*.adapters

[importlinter:contract:frameworks]
name = Application and ports have no web or ORM framework dependencies
type = forbidden
source_modules =
    src.modules.*.application
    src.modules.*.ports
    src.read.application
    src.read.ports
forbidden_modules =
    fastapi
    starlette
    sqlalchemy

[importlinter:contract:services]
name = Application services do not depend on use cases
type = forbidden
source_modules =
    src.modules.*.application.services
forbidden_modules =
    src.modules.*.application.use_cases

# Planning & fulfillment is one module because the lifecycle reconciler is one transaction
# boundary, so its use-case groups are layered inside it instead (docs/reference/module-boundaries.md
# section 4.6). From the top: the dashboard and todo readers compose what the groups below
# list; awarding a quote request creates an order and assigns lot positions, and the
# source item allocations reuse the source item demand family; the order, demand, bucket,
# production order, machine and settings groups are independent of each other; orders,
# demands and production orders create or cancel lots; every write that changes the plan runs
# the machine schedule recompute; the demand family holds the use cases the three demand kinds
# share; application services sit below every group.
[importlinter:contract:fulfillment-use-case-layers]
name = Planning & fulfillment use-case groups depend only downwards
type = layers
containers =
    src.modules.fulfillment.application
layers =
    use_cases.dashboard | use_cases.todo
    use_cases.quote_request | use_cases.source_item_allocation
    use_cases.order | use_cases.bought_item_demand | use_cases.made_item_demand | use_cases.source_item_demand | use_cases.bought_item_demand_bucket | use_cases.made_item_demand_bucket | use_cases.source_item_demand_bucket | use_cases.production_order | use_cases.production_machine | use_cases.machine_pool | use_cases.admin_settings
    use_cases.production_lot
    use_cases.production_schedule | use_cases._demand_family
    services

[importlinter:contract:kernel]
name = The shared kernel imports no module
type = forbidden
source_modules =
    src.shared_kernel
forbidden_modules =
    src.modules
    src.read
    src.bootstrap

[importlinter:contract:read-tier]
name = Nothing imports the read tier but the composition root
type = forbidden
source_modules =
    src.modules
    src.shared_kernel
forbidden_modules =
    src.read
allow_indirect_imports = True

[importlinter:contract:read-tier-public-api]
name = The read tier reaches the modules only through their public API
type = forbidden
source_modules =
    src.read
forbidden_modules =
    src.modules.*.application.use_cases
    src.modules.*.adapters.inbound.api.v1
    src.modules.*.adapters.inbound.mcp.catalog
    src.modules.*.adapters.outbound.external
    src.modules.*.adapters.outbound.persistence.repositories
    src.modules.*.ports.outbound.repositories
    src.modules.catalogue.application.services
    src.modules.catalogue.domain.services
    src.modules.workspace.application.services
    src.modules.workspace.domain.services
    src.modules.external_data.application.services
    src.modules.external_data.domain.services
    src.modules.fulfillment.application.services
    src.modules.fulfillment.domain.services
    src.modules.fulfillment.infrastructure
    src.modules.quality.application.services
    src.modules.quality.domain.services
    src.modules.operations.application.services
    src.modules.operations.domain.services
    src.modules.operations.infrastructure
allow_indirect_imports = True

[importlinter:contract:composition-root]
name = Nothing imports the composition root
type = forbidden
source_modules =
    src.modules
    src.read
    src.shared_kernel
forbidden_modules =
    src.bootstrap

[importlinter:contract:platform-dependencies]
name = Platform imports only the shared kernel
type = forbidden
source_modules =
    src.modules.platform
forbidden_modules =
    src.modules.catalogue
    src.modules.workspace
    src.modules.external_data
    src.modules.fulfillment
    src.modules.quality
    src.modules.operations
allow_indirect_imports = True

[importlinter:contract:catalogue-dependencies]
name = Catalogue imports only Platform
type = forbidden
source_modules =
    src.modules.catalogue
forbidden_modules =
    src.modules.workspace
    src.modules.external_data
    src.modules.fulfillment
    src.modules.quality
    src.modules.operations
allow_indirect_imports = True

[importlinter:contract:workspace-dependencies]
name = Workspace imports only Platform, Catalogue
type = forbidden
source_modules =
    src.modules.workspace
forbidden_modules =
    src.modules.external_data
    src.modules.fulfillment
    src.modules.quality
    src.modules.operations
allow_indirect_imports = True

[importlinter:contract:external-data-dependencies]
name = CAD & external data imports only Platform, Catalogue
type = forbidden
source_modules =
    src.modules.external_data
forbidden_modules =
    src.modules.workspace
    src.modules.fulfillment
    src.modules.quality
    src.modules.operations
allow_indirect_imports = True

[importlinter:contract:fulfillment-dependencies]
name = Planning & fulfillment imports only Platform, Catalogue, Workspace
type = forbidden
source_modules =
    src.modules.fulfillment
forbidden_modules =
    src.modules.external_data
    src.modules.quality
    src.modules.operations
allow_indirect_imports = True

[importlinter:contract:quality-dependencies]
name = Quality & documents imports only Platform, Catalogue, Workspace, Planning & fulfillment
type = forbidden
source_modules =
    src.modules.quality
forbidden_modules =
    src.modules.external_data
    src.modules.operations
allow_indirect_imports = True

[importlinter:contract:operations-dependencies]
name = Operations imports only Platform, Catalogue, Planning & fulfillment
type = forbidden
source_modules =
    src.modules.operations
forbidden_modules =
    src.modules.workspace
    src.modules.external_data
    src.modules.quality
allow_indirect_imports = True

