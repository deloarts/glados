protected_modules =
    src.modules.quality.adapters.inbound.api.schemas
allowed_importers =
    src.modules.quality
    src.modules.*.adapters.inbound
    src.read.adapters.inbound
    src.bootstrap

[importlinter:contract:operations-privacy]
name = Other modules use only the public API of Operations
type = protected
protected_modules =
    src.modules.operations.domain.services
    src.modules.operations.application.use_cases
    src.modules.operations.application.services
    src.modules.operations.adapters.inbound.api.terminal_auth_deps
    src.modules.operations.adapters.inbound.api.v1
    src.modules.operations.adapters.outbound.external
    src.modules.operations.adapters.outbound.persistence.repositories._admin_settings_mappers
    src.modules.operations.adapters.outbound.persistence.repositories.infoscreen_repository
    src.modules.operations.adapters.outbound.persistence.repositories.terminal_broadcast_repository
    src.modules.operations.adapters.outbound.persistence.repositories.terminal_repository
    src.modules.operations.adapters.outbound.persistence.repositories.time_tracking_credentials_repository
    src.modules.operations.adapters.outbound.persistence.time_tracking_fingerprints
    src.modules.operations.ports.outbound.repositories
    src.modules.operations.infrastructure
allowed_importers =
    src.modules.operations
    src.bootstrap

[importlinter:contract:operations-models]
name = Only persistence adapters use the ORM models and row mappers of Operations
type = protected
protected_modules =
    src.modules.operations.adapters.outbound.persistence.models
allowed_importers =
    src.modules.operations
    src.modules.*.adapters.outbound.persistence
    src.read.adapters.outbound.persistence
    src.bootstrap

[importlinter:contract:operations-deps]
name = Only dependency factories use the dependency factories of Operations
type = protected
protected_modules =
    src.modules.operations.adapters.inbound.api.deps
allowed_importers =
    src.modules.operations
    src.modules.*.adapters.inbound.api.deps
    src.bootstrap

[importlinter:contract:operations-schemas]
name = Only inbound adapters use the API schemas of Operations
type = protected
protected_modules =
    src.modules.operations.adapters.inbound.api.schemas
allowed_importers =
    src.modules.operations
    src.modules.*.adapters.inbound
    src.read.adapters.inbound
    src.bootstrap
