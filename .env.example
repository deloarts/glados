# ─────────────────────────────────────────────────────────────
# GLADOS production environment template
#
# Copy this file to .env (or a custom file referenced via ENV_FILE, e.g.
# stack.env for Portainer) and fill in real values before deploying with
# docker-compose.yml.
# ─────────────────────────────────────────────────────────────

# ── Release ─────────────────────────────────────────────────────────────
# Image tag pulled from GHCR for backend and frontend. Required: compose
# refuses to start without it, so nothing ever pulls "latest".
# Recommended: pin a minor (e.g. v0.1) so patch releases arrive on the
# next `docker compose pull`. Pin an exact tag (e.g. v0.1.2) for fully
# reproducible deploys.
GLADOS_VERSION=v0.1

# Per-component version overrides; normally unset (both fall back to
# GLADOS_VERSION above).
# BACKEND_VERSION=
# FRONTEND_VERSION=

# Host interface and port the frontend is published on (defaults
# 127.0.0.1 and 8080). The host's reverse proxy forwards to this port; keep
# the loopback binding unless something in front of the host filters
# traffic (docs/INSTALLATION.md section 6.2).
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=8080

# Env file docker compose loads instead of .env, e.g. stack.env for
# Portainer, which manages its own env file naming.
# ENV_FILE=stack.env

# Subnets of the stack's two Docker networks (defaults shown). Change them
# only when they overlap a network the host must reach, then recreate the
# networks with `docker compose down` and `docker compose up -d`.
# GLADOS_INTERNAL_SUBNET=192.168.240.0/24
# GLADOS_EXTERNAL_SUBNET=192.168.241.0/24
# Addresses or CIDR networks (comma separated) whose X-Forwarded-For the
# frontend's nginx believes, or "none". The default, GLADOS_EXTERNAL_SUBNET,
# covers a reverse proxy on this host and the Cloudflare Tunnel. Set "none"
# when clients reach the published port directly, or the proxy's address
# when it runs on another machine (docs/INSTALLATION.md section 6.7). Never
# list a network clients connect from.
# GLADOS_TRUSTED_PROXIES=192.168.241.0/24

# ── App ────────────────────────────────────────────────────────────────
# Disables debug mode; must be false in production (enables secure cookies).
DEBUG=false
# Public URL the app is served from; used for links, cookies, and CORS.
DOMAIN=https://glados.example.com
# Minimum level per destination: DEBUG, INFO, WARNING, or ERROR, set
# independently. LOG_LEVEL is what reaches stdout, LOG_DB_LEVEL what is
# stored in the database and shown in the in-app Logs tab. Request audit
# rows are kept regardless of either.
LOG_LEVEL=INFO
LOG_DB_LEVEL=INFO
# Stdout log line format: "text" for humans, "json" (one object per line)
# for a log aggregator such as Loki or Elastic.
LOG_FORMAT=text

# ── Database ───────────────────────────────────────────────────────────
# Full SQLAlchemy connection string. "postgres" is the compose service
# name; point this at an external Postgres host instead if you aren't
# using the bundled postgres service.
DATABASE__URL=postgresql+psycopg://glados:change_me@postgres:5432/glados
# Number of gunicorn worker processes in the backend container (default 4).
# GUNICORN_WORKERS=4

# Connection pool per gunicorn worker, and server-side limits applied to
# every backend connection (seconds, 0 disables). Defaults shown; the total
# across workers, workers x (POOL_SIZE + MAX_OVERFLOW), must stay well below
# Postgres' max_connections (100, set in docker-compose.yml).
# DATABASE__POOL_SIZE=5
# DATABASE__MAX_OVERFLOW=5
# DATABASE__POOL_TIMEOUT_SECONDS=10
# DATABASE__STATEMENT_TIMEOUT_SECONDS=30
# DATABASE__LOCK_TIMEOUT_SECONDS=5
# DATABASE__IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=60
# Statements slower than this (ms) are logged with their request context
# and counted in glados_db_slow_queries_total; 0 disables.
# DATABASE__SLOW_QUERY_THRESHOLD_MS=500

# Postgres container vars, read by the postgres image itself, not the
# backend. DATABASE__URL above uses the same user, password and database.
POSTGRES_USER=glados
POSTGRES_PASSWORD=change_me
POSTGRES_DB=glados

# ── Redis ──────────────────────────────────────────────────────────────
# Redis connection string. "redis" is the compose service name; point
# this at an external Redis instance instead if you aren't using the
# bundled redis service.
REDIS__URL=redis://redis:6379/0
# Shared Redis client limits (defaults shown). socket_timeout must stay
# above the event workers' 1s stream block.
# REDIS__SOCKET_TIMEOUT_SECONDS=3
# REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=2
# REDIS__MAX_CONNECTIONS=50
# REDIS__RETRIES=1

# ── Security (JWT signing and secret encryption, never commit real values)
# Every key needs at least 32 characters, or a production backend refuses
# to start. `openssl rand -hex 32` generates one.
# Signing key for persistent (long-lived) JWTs; generate a unique random value.
SECURITY__SECRET_KEY_PERSISTENT=change_me
# Signing key for non-persistent (short-lived) JWTs; generate a unique random value.
SECURITY__SECRET_KEY_NON_PERSISTENT=change_me
# Encrypts secrets stored in the database (SMTP, storage, PDM and time-tracking
# credentials, webhook secrets, TOTP secrets). Must differ
# from both signing keys. Changing it makes those secrets unreadable unless the
# old value is set as SECURITY__ENCRYPTION_KEY_PREVIOUS for one restart.
# Back it up with the database: a restored dump needs the same key.
SECURITY__ENCRYPTION_KEY=change_me
# SECURITY__ENCRYPTION_KEY_PREVIOUS=
# Encrypts the database backup archives and the pre-migration dumps. Must
# differ from every key above. Without it the backend refuses to write a
# scheduled backup, and the Backups tab and /ready warn. Keep a copy apart
# from the backups: an archive cannot be restored without the key it was
# written with.
SECURITY__BACKUP_ENCRYPTION_KEY=change_me

# ── Upgrades ───────────────────────────────────────────────────────────
# Before it applies pending migrations, the backend dumps the database into
# this directory (a volume in docker-compose.yml) and keeps the newest few
# dumps. A failed dump stops the start instead of migrating without a way
# back. Defaults shown.
# BACKUP__PRE_MIGRATION_DUMP_DIR=./pre-migration-dumps
# BACKUP__PRE_MIGRATION_DUMP_KEEP=3
# Set to true only to migrate without that dump, for example once you have
# taken a dump by other means after a failed one.
# GLADOS_SKIP_PRE_MIGRATION_DUMP=false

# ── SOLIDWORKS PDM ─────────────────────────────────────────────────────
# true lets the admin API console run mutating PDM Web API operations
# (check-in, delete, state changes), still behind its own per-visit switch.
# Off by default: Glados cannot undo them on a live vault.
# PDM__ALLOW_MUTATING_OPERATIONS=false

# ── Storage ────────────────────────────────────────────────────────────
# Directory inside the backend container where uploaded media is stored.
LOCAL_STORAGE__BASE_DIR=./media

# ── System user seed ───────────────────────────────────────────────────
# Full name of the initial admin user, created on first run.
INIT__FULL_NAME=Glados Admin
# Email address of the initial admin user.
INIT__MAIL=admin@example.com
# Password of the initial admin user, the "system" account. Every start
# sets the account back to this value, so change it here, not in the app.
# Production refuses to start with the sample value or fewer than 12
# characters.
INIT__PASSWORD=change_me

# ── SeaweedFS (optional, --profile seaweedfs) ──────────────────────────
# S3 access key of the bundled SeaweedFS instance; enter the same pair in
# Admin Settings → Storage.
SEAWEEDFS_ACCESS_KEY=glados
# S3 secret key of the bundled SeaweedFS instance. nginx serves its S3 API
# under /objects/, so with the profile on, the stack and the backend refuse
# to start with the sample value or fewer than 24 characters.
SEAWEEDFS_SECRET_KEY=change_me
# ── pgAdmin (optional, --profile pgadmin) ──────────────────────────────
# Login for the pgAdmin console itself (not the database user). Passed only
# to the pgadmin container. Start the profile for the task at hand and stop
# it again afterwards.
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=change_me
# Host port pgAdmin listens on (default 5050) and the interface it binds to
# (default 127.0.0.1, reach it through an SSH tunnel). 0.0.0.0 exposes it on
# every interface; only do that on a host without shell access that sits on
# a trusted network.
# PGADMIN_PORT=5050
# PGADMIN_BIND=127.0.0.1
# ── Cloudflare Tunnel (optional, --profile cloudflare) ─────────────────
# Tunnel token from the Cloudflare Zero Trust dashboard (connector type
# "cloudflared"). Passed only to the cloudflared container.
# TUNNEL_TOKEN=
