{
  "name": "glados-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:visual": "docker run --rm --init --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test",
    "readme:media": "docker run --rm --init --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test -c playwright.readme.config.ts && python3 e2e/readme/assemble.py test-results/readme ../docs/assets",
    "test:coverage": "vitest run --coverage",
    "test:coverage:shard": "vitest run --reporter=blob --reporter=dot --coverage --coverage.thresholds.lines=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0",
    "test:coverage:merge": "vitest run --merge-reports --coverage",
    "test:guards": "vitest run src/__tests__/featureContexts.spec.ts src/__tests__/featureImportCycles.spec.ts src/__tests__/a11yClickableElements.spec.ts src/__tests__/a11yIconButtonLabels.spec.ts src/core/api/__tests__/canonicalPaths.spec.ts src/features/handbook/utils/__tests__/handbookContent.spec.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache --cache-strategy content",
    "lint:stylelint": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "lint:check": "run-s lint:check:*",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint . --cache --cache-strategy content",
    "lint:check:stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "lint:check:max-lines": "jiti scripts/check-max-lines-baseline.ts",
    "check:i18n": "jiti scripts/check-i18n-parity.ts",
    "generate:api-types": "jiti scripts/generate-api-types.ts",
    "check:api-types": "jiti scripts/generate-api-types.ts --check",
    "check:audit": "jiti scripts/check-audit.ts",
    "ci": "run-s type-check lint:check test:unit:run check:i18n check:api-types"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@openvue/themes": "1.0.0",
    "@svar-ui/vue-gantt": "^2.8.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.7.8",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "countries-list": "^3.4.1",
    "dompurify": "^3.4.17",
    "iso-639-1": "^3.1.6",
    "markdown-it": "^15.0.2",
    "openvue": "1.0.0",
    "pdfmake": "^0.3.11",
    "pinia": "^4.1.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vuedraggable": "^4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@openvue/auto-import-resolver": "1.0.0",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.89.0",
    "eslint-plugin-vue": "~10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.89.0",
    "postcss-html": "^2.0.0",
    "sass-embedded": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.22.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "minimatch": "^11.0.1"
  }
}
